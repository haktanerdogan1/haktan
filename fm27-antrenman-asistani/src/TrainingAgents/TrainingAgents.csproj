<Project Sdk="Microsoft.NET.Sdk">

  <!-- TrainingAgents masaüstü uygulaması: motoru ve paneli tek bir pencerede çalıştırır (Photino; Windows'ta WebView2),
       oyunu MCPFM üzerinden birkaç saniyede bir yoklar. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrainingAgents</AssemblyName>
    <RootNamespace>TrainingAgents</RootNamespace>
    <ApplicationIcon>TrainingAgents.ico</ApplicationIcon>
    <Product>TrainingAgents</Product>
    <AssemblyTitle>TrainingAgents</AssemblyTitle>
    <Company>TrainingAgents</Company>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Tek dosya, .NET kurulumu gerektirmeyen exe: dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Asistan.Core\Asistan.Core.csproj" />
    <Compile Include="..\Asistan.Tests\SahteOyun.cs" Link="Demo\SahteOyun.cs" />
    <EmbeddedResource Include="TrainingAgents.ico" />
  </ItemGroup>

</Project>
